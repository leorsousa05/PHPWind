{
    "name": "phpwind/phpwind",
    "description": "Tailwind CSS v4 standalone CLI wrapper for PHP projects without Node.js dependency",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "PHPWind Team"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PHPWind\\": "src/"
        },
        "files": [
            "src/Helper/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PHPWind\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpwind"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
