{
    "name": "leorsousa05/phpwind",
    "version": "1.2.0",
    "description": "Tailwind CSS v3 & v4 standalone CLI wrapper for PHP projects without Node.js dependency",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Leandro Sousa",
            "homepage": "https://github.com/leorsousa05"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PHPWind\\": "src/"
        },
        "files": [
            "src/Helper/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PHPWind\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpwind"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
