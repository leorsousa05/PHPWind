{
    "name": "phpwind/phpwind",
    "version": "1.7.0",
    "description": "Tailwind CSS v3 & v4 standalone CLI wrapper for PHP projects without Node.js dependency",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Leandro Sousa",
            "homepage": "https://github.com/leorsousa05"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "symfony/framework-bundle": "To integrate PHPWind natively into Symfony applications",
        "twig/twig": "To use the {{ phpwind_css() }} Twig template function in Symfony"
    },
    "autoload": {
        "psr-4": {
            "PHPWind\\": "src/"
        },
        "files": [
            "src/Helper/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PHPWind\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/phpwind"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
