#!/usr/bin/env php
<?php

$autoloadFiles = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    getcwd() . '/vendor/autoload.php',
];

$loaded = false;
foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        require_once $file;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Autoload file not found. Please run composer install.\n");
    exit(1);
}

use PHPWind\Command\CleanHandler;
use PHPWind\Command\InitHandler;
use PHPWind\Compiler\TailwindCompiler;
use PHPWind\Config\PHPWindConfig;

$args = array_slice($argv, 1);
$action = $args[0] ?? 'build';

$minify = in_array('--minify', $args) || in_array('-m', $args);
$watch = $action === 'watch' || in_array('--watch', $args) || in_array('-w', $args);
$noInteraction = in_array('--no-interaction', $args) || in_array('-n', $args);

$input = 'resources/css/app.css';
$output = 'public/css/app.css';
$version = 'v4.0.0';

foreach ($args as $index => $arg) {
    if (($arg === '-i' || $arg === '--input') && isset($args[$index + 1])) {
        $input = $args[$index + 1];
    }
    if (($arg === '-o' || $arg === '--output') && isset($args[$index + 1])) {
        $output = $args[$index + 1];
    }
    if (str_starts_with($arg, '--version=')) {
        $version = substr($arg, 10);
    }
}

if ($action === 'init') {
    $createSampleHtml = false;

    if (!$noInteraction && function_exists('stream_isatty') && stream_isatty(STDIN)) {
        fwrite(STDOUT, "\n  🌬️ Welcome to PHPWind Interactive Setup Wizard!\n\n");
        
        fwrite(STDOUT, "Input CSS path [resources/css/app.css]: ");
        $readInput = trim(fgets(STDIN));
        if ($readInput !== '') {
            $input = $readInput;
        }

        fwrite(STDOUT, "Output CSS path [public/css/app.css]: ");
        $readOutput = trim(fgets(STDIN));
        if ($readOutput !== '') {
            $output = $readOutput;
        }

        fwrite(STDOUT, "Tailwind version (v4.0.0, v3.4.17) [v4.0.0]: ");
        $readVersion = trim(fgets(STDIN));
        if ($readVersion !== '') {
            $version = $readVersion;
        }

        fwrite(STDOUT, "Create sample index.php file? (y/N) [N]: ");
        $readSample = strtolower(trim(fgets(STDIN)));
        $createSampleHtml = $readSample === 'y' || $readSample === 'yes';
        fwrite(STDOUT, "\n");
    }

    $config = new PHPWindConfig(
        inputCss: $input,
        outputCss: $output,
        version: $version
    );

    $handler = new InitHandler();
    $handler->handle($config, $createSampleHtml);

    fwrite(STDOUT, "✓ PHPWind initialized input CSS at {$input}\n");
    if ($createSampleHtml) {
        fwrite(STDOUT, "✓ Sample index.php created successfully.\n");
    }
    exit(0);
}

$config = new PHPWindConfig(
    inputCss: $input,
    outputCss: $output,
    version: $version,
    minify: $minify,
    watch: $watch
);

if ($action === 'clean' || $action === 'purge') {
    $cleanOutput = in_array('--all', $args);
    $handler = new CleanHandler();
    $handler->handle($config, $cleanOutput);
    fwrite(STDOUT, "PHPWind cache and binary cleaned successfully.\n");
    exit(0);
}

$compiler = new TailwindCompiler();
$exitCode = $compiler->compile($config);

exit($exitCode);
