#!/usr/bin/env php
<?php

$autoloadFiles = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    getcwd() . '/vendor/autoload.php',
];

$loaded = false;
foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        require_once $file;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Autoload file not found. Please run composer install.\n");
    exit(1);
}

use PHPWind\Binary\PlatformResolver;
use PHPWind\Command\CleanHandler;
use PHPWind\Command\InitHandler;
use PHPWind\Command\DoctorHandler;
use PHPWind\Command\BuildOutputFormatter;
use PHPWind\Compiler\TailwindCompiler;
use PHPWind\Config\PHPWindConfig;
use PHPWind\Config\Env;
use PHPWind\Console\ViteStyleWizard;

$args = array_slice($argv, 1);
$action = $args[0] ?? 'build';

$minify = in_array('--minify', $args) || in_array('-m', $args);
$watch = $action === 'watch' || in_array('--watch', $args) || in_array('-w', $args);

$input = 'resources/css/app.css';
$output = 'public/css/app.css';
$version = PlatformResolver::DEFAULT_VERSION;

foreach ($args as $index => $arg) {
    if (($arg === '-i' || $arg === '--input') && isset($args[$index + 1])) {
        $input = $args[$index + 1];
    }
    if (($arg === '-o' || $arg === '--output') && isset($args[$index + 1])) {
        $output = $args[$index + 1];
    }
    if (str_starts_with($arg, '--version=')) {
        $version = substr($arg, 10);
    }
}

if ($action === 'init') {
    $wizardData = ViteStyleWizard::run($args);

    $config = new PHPWindConfig(
        inputCss: $wizardData['input'],
        outputCss: $wizardData['output'],
        version: $wizardData['version']
    );

    $handler = new InitHandler();
    $handler->handle($config, $wizardData['create_sample']);

    ViteStyleWizard::printNextSteps($wizardData['input'], $wizardData['output'], $wizardData['preset']);
    exit(0);
}

if ($action === 'doctor') {
    $doctorConfig = PHPWindConfig::fromArray(is_file('config/phpwind.php') ? require 'config/phpwind.php' : []);
    $result = (new DoctorHandler())->diagnose($doctorConfig);
    fwrite(STDOUT, $result['output']);
    exit($result['exitCode']);
}

$configValues = is_file('config/phpwind.php') ? require 'config/phpwind.php' : [];
$config = PHPWindConfig::fromArray(array_merge([
    'download_timeout' => Env::get('PHPWIND_DOWNLOAD_TIMEOUT', 120),
    'verify_ssl' => Env::get('PHPWIND_VERIFY_SSL', true),
], $configValues, [
    'input_css' => $input,
    'output_css' => $output,
    'version' => $version,
    'minify' => $minify,
    'watch' => $watch,
]));

if ($action === 'clean' || $action === 'purge') {
    $cleanOutput = in_array('--all', $args);
    $handler = new CleanHandler();
    $handler->handle($config, $cleanOutput);
    fwrite(STDOUT, "PHPWind cache and binary cleaned successfully.\n");
    exit(0);
}

try {
    $result = (new TailwindCompiler())->compileResult($config);
    if ($result->exitCode === 0) {
        fwrite(STDOUT, BuildOutputFormatter::success() . "\n");
    } else {
        fwrite(STDERR, BuildOutputFormatter::failure($result) . "\n");
    }
    $exitCode = $result->exitCode;
} catch (Throwable $exception) {
    fwrite(STDERR, BuildOutputFormatter::exception($exception) . "\n");
    $exitCode = 1;
}

exit($exitCode);
